datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id              String           @id @default(uuid()) @db.Uuid
  phoneNumber     String           @unique
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  loans           Loan[]
  refreshSessions RefreshSession[]

  @@map("users")
}

model OtpChallenge {
  id          String    @id @default(uuid()) @db.Uuid
  phoneNumber String
  hashedOtp   String
  expiresAt   DateTime
  attempts    Int       @default(0)
  createdAt   DateTime  @default(now())
  consumedAt  DateTime?

  @@index([phoneNumber])
  @@index([expiresAt])
  @@map("otp_challenges")
}

model RefreshSession {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  hashedToken String    @unique
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  userAgent   String?
  ipAddress   String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([hashedToken])
  @@map("refresh_sessions")
}

model Loan {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  friendName  String
  amount      BigInt   // integer paise
  dueDate     DateTime @db.Date // date-only representation
  status      String   @default("OUTSTANDING") // OUTSTANDING | REPAID
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  repayments Repayment[]
  receipt    Receipt?

  @@index([userId])
  @@index([dueDate])
  @@index([status])
  @@index([userId, status])
  @@index([userId, dueDate])
  @@map("loans")
}

model Repayment {
  id             String   @id @default(uuid()) @db.Uuid
  loanId         String   @db.Uuid
  amount         BigInt   // integer paise
  repaidAt       DateTime @default(now())
  createdAt      DateTime @default(now())
  idempotencyKey String?  @unique

  loan Loan @relation(fields: [loanId], references: [id], onDelete: Restrict)

  @@index([loanId])
  @@index([idempotencyKey])
  @@map("repayments")
}

model Receipt {
  id           String   @id @default(uuid()) @db.Uuid
  loanId       String   @unique @db.Uuid
  storageKey   String
  originalName String
  contentType  String
  sizeBytes    Int
  createdAt    DateTime @default(now())

  loan Loan @relation(fields: [loanId], references: [id], onDelete: Cascade)

  @@map("receipts")
}
