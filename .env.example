# Node Server Environment
PORT=4000
NODE_ENV=development

# Database Configuration (PostgreSQL)
# Note: For Docker default port is 5432. For local Windows with existing service, 5433 is used.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/miniledger?schema=public
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/miniledger_test?schema=public

# JWT Secrets (Generate secure random 64-char strings for production)
JWT_ACCESS_SECRET=miniledger_dev_access_secret_super_secure_key_at_least_32_chars
JWT_REFRESH_SECRET=miniledger_dev_refresh_secret_super_secure_key_at_least_32_chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY_DAYS=30

# Development Mode Options
# CRITICAL: In production, ENABLE_DEV_OTP must be set to false. Server will refuse to start in production if true.
ENABLE_DEV_OTP=true

# CORS and Security
CORS_ORIGIN=*
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=900000

# Receipt Storage (local | s3)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads

# Mobile Client API Base URL
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1
